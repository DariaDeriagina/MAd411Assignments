<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Expense Name -->
        <EditText
            android:id="@+id/expenseNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expense Name"
            android:textSize="16sp"
            android:inputType="textPersonName" />

        <!-- Date -->
        <EditText
            android:id="@+id/expenseDateEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date (DD/MM/YYYY)"
            android:focusable="false"
            android:clickable="true"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <!-- Amount -->
        <EditText
            android:id="@+id/expenseAmountEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <!-- Cost Associated Checkbox -->
        <CheckBox
            android:id="@+id/costAssociatedCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cost Associated?"
            android:layout_marginTop="12dp" />

        <!-- Currency Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Currency:"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/currencySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Converted Cost -->
        <TextView
            android:id="@+id/convertedCostTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Converted Cost: $0.00"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/saveExpenseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
